<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>foundation.aep</groupId>
    <artifactId>aep-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>aep-examples</artifactId>
  <name>AEP Java Examples</name>
  <description>Runnable Agent, Service, and Platform examples for AEP Java.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>foundation.aep</groupId>
      <artifactId>aep-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>foundation.aep</groupId>
      <artifactId>aep-httpserver</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>foundation.aep</groupId>
      <artifactId>aep-json-jackson2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>foundation.aep</groupId>
      <artifactId>aep-platform</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>run-agent-service-example</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <arguments>
                <argument>-classpath</argument>
                <classpath />
                <argument>foundation.aep.examples.AgentServiceExample</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>run-platform-example</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <arguments>
                <argument>-classpath</argument>
                <classpath />
                <argument>foundation.aep.examples.PlatformExample</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
